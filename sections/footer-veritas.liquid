{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .background-color-red {
    background-color: var(--red);
  }

  .padding-footer {
    padding-left: 2%;
    padding-right: 2%;
  }
  .w-layout-grid {
    grid-row-gap: 16px;
    grid-column-gap: 16px;
    grid-template-rows: auto auto;
    grid-template-columns: 1fr 1fr;
    grid-auto-columns: 1fr;
    display: grid;
  }

  .footer4_top-wrapper {
    grid-column-gap: 1vw;
    grid-template-rows: auto;
    grid-template-columns: 1fr 1fr 1fr;
    justify-content: space-between;
    align-items: center;
  }

  .footer4_logo-link {
    padding-left: 0;
  }

  #w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaaab-21afaaa5 {
    justify-self: start;
  }

  .footer4-div-personalizada {
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    display: flex;
  }

  .footer4-div-personalizada.personalizado {
    flex-flow: column;
    align-items: flex-start;
  }

  .footer4_social-list {
    grid-column-gap: 0.75rem;
    grid-row-gap: 0rem;
    white-space: normal;
    flex-flow: column;
    grid-template-rows: auto auto;
    grid-template-columns: max-content;
    grid-auto-columns: max-content;
    grid-auto-flow: column;
    align-items: start;
    justify-items: start;
    width: 151%;
    display: flex;
  }

  @media (max-width: 750px) {
    .footer4_social-list {
      gap: 32px;
    }
  }

  .div-block-4 {
    justify-content: space-between;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    display: flex;
  }

  #w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaab5-21afaaa5 {
    justify-self: end;
  }

  .footer-block-evento {
    flex-flow: column;
    justify-content: space-between;
    align-items: flex-end;
    display: flex;
  }

  .art-over-footer-wrap {
    display: flex;
    flex-direction: column;
    margin-top: 3.2rem;
    gap: 1.6rem;
  }

  .btn-footer {
    color: var(--white);
    text-align: center;
    padding: 0.75rem 1.5rem;
    text-decoration: none;
  }

  .btn-footer.is-link {
    padding: 0.25rem 0;
    text-decoration: none;
    text-align: right;
  }

  .btn-footer.is-big-foint {
    padding: 0.25rem 60px 0.25rem 4px;
    font-size: 2.24rem;
    background-color: var(--red);
    line-height: 1.4;
    margin-top: 8px;
  }

  @media screen and (max-width: 991px) {
    .footer4_top-wrapper {
      grid-row-gap: 4.8rem;
      grid-template-columns: 0.5fr 0.75fr 1fr;
      justify-content: center;
      justify-items: stretch;
    }
  }

  @media screen and (max-width: 750px) {
    .footer4_top-wrapper {
      flex-flow: column;
      grid-template-columns: 0.5fr;
      justify-content: center;
      align-items: flex-start;
      justify-items: start;
      display: flex;
    }
  }

  @media screen and (max-width: 991px) {
    #w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaaab-21afaaa5 {
      justify-self: center;
    }
  }

  @media screen and (max-width: 479px) {
    #w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaaab-21afaaa5 {
      grid-area: span 1 / span 1 / span 1 / span 1;
    }
  }

  @media screen and (max-width: 991px) {
    #w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaab5-21afaaa5 {
      justify-self: center;
    }
  }

  @media screen and (max-width: 750px) {
    .text-vetor.footer {
      margin-bottom: 7px;
      margin-right: -3px;
    }
  }

  .footer-boma {
    padding-inline: 14px;
    padding-top: 32px;
    padding-bottom: 0;
    color: white;
    background-color: var(--marrom);
  }

  @media (min-width: 749px) {
    .footer-boma {
      padding-inline: 2%;
    }
  }

  .copyright_wrap {
    padding-top: 48px;
    padding-bottom: 16px;
    gap: 2.4rem;
    width: 100%;
    justify-content: space-between;
    flex-direction: column-reverse;
    line-height: 1;
  }

  @media (min-width: 749px) {
    .copyright_wrap {
      flex-direction: row;
      padding-top: 3.2rem;
      align-items: end;
    }
  }

  .fm-roboto {
    font-family: 'Roboto', sans-serif;
    text-transform: none;
    letter-spacing: -0.0175rem;
  }

  .copyright_links a:not(:last-child) {
    margin-right: 20px;
  }

  @media (max-width: 750px) {
    .copyright_links {
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
  }
</style>

<style>
  .text-align-center {
    text-align: center;
  }

  .margin-small {
    margin: 1.5rem;
  }

  .margin-top,
  .margin-top.margin-small {
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
  }

  .w-form {
    margin: 0 0 15px;
  }

  .cta26_form-block {
    width: 100%;
    max-width: 100%;
    margin-bottom: 0;
    margin-left: auto;
    margin-right: auto;
  }

  .text-with-vector-footer {
    flex-flow: wrap;
    display: flex;
  }

  .margin-bottom,
  .margin-bottom.margin-small {
    margin-top: 0;
    margin-left: 0;
    margin-right: 0;
  }

  .d-inline-flex {
    display: flex;
  }

  .cta26_form {
    width: 100%;
  }

  .signup-form-wrapper {
    grid-column-gap: 1rem;
    grid-row-gap: 1rem;
    grid-template-rows: auto;
    grid-template-columns: 1fr max-content;
    grid-auto-columns: 1fr;
    display: grid;
  }

  @media screen and (max-width: 991px) {
    .text-vetor {
      margin-bottom: 11px;
    }
    .text-vetor.footer {
      margin-bottom: 6px;
    }
  }

  @media screen and (max-width: 750px) {
    .text-vetor {
      width: 60px;
    }
  }

  @media screen and (max-width: 479px) {
    .signup-form-wrapper {
      grid-row-gap: 0.75rem;
      flex-direction: column;
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .text-size-tiny.text-align-left {
      overflow-wrap: break-word;
    }
  }

  .newsletter_wrap-footer {
    max-width: 570px;
    margin: auto;
  }

  .form_input-footer {
    border: 2px solid #0000ff;
    background-color: #fff;
    color: var(--white);
    border-radius: 0;
    height: auto;
    min-height: 2.75rem;
    margin-bottom: 0;
    padding: 0.5rem 0.75rem;
    font-size: 1rem;
    line-height: 1.6;
    width: 100%;
  }

  .politica-newsletter {
    font-size: 1.2rem;
  }

  @media screen and (max-width: 479px) {
    .btn-primary.h6-sg {
      font-size: 1.4rem;
    }

    .mobile-14.copyright {
      font-size: 1rem;
    }
  }

  .opacity-70 {
    opacity: 0.7;
  }

  .toonbo {
    text-decoration: underline;
  }

  @media (min-width: 750px) {
    .mobile-links {
      display: none;
    }

    .opacity-md-70 {
      opacity: 0.7;
    }
  }

  .footer-boma-wrap {
    display: flex;
    gap: 32px;
    width: 100%;
    align-items: flex-end;
  }

  .atendimento {
    text-align: right;
  }

  .social-wrap {
    align-items: end;
  }
</style>

<div class="section-{{ section.id }}-padding">
  <footer class="footer-boma ">
    <div class="w-layout-grid footer4_top-wrapper text-color-white">
      <div class="footer-boma-wrap">
        <div
          id="w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaab5-21afaaa5"
          class="w-layout-grid footer4_social-list div-block-4 mobile-links"
        >
          <div class="d-flex flex-column social-wrap">
            <div class="d-flex align-items-center">
              <a
                href="https://www.instagram.com/weare_boma/"
                target="_blank"
                class="btn-footer is-link text-sg  h5-md-sg text-color-white"
                >instagram</a
              >
            </div>
            <div class="d-flex align-items-center">
              <a
                href="https://www.youtube.com/@boma3263"
                target="_blank"
                class="btn-footer is-link text-sg  h5-md-sg text-color-white"
                >youtube</a
              >
            </div>
            <div class="d-flex align-items-center">
              <a
                href="https://open.spotify.com/user/jpmhidxq4xu5d9uhf249wgku3?si=58ac76862e66495b"
                target="_blank"
                class="btn-footer is-link text-sg h5-md-sg text-color-white"
                >spotify</a
              >
            </div>
          </div>
        </div>
      </div>

      <div class="footer4-div-personalizada personalizado">
        <div class="footer-block-evento text-color-black">
          <div class="newsletter_wrap-footer">
            <div class="margin-bottom margin-small">
              <div class="text-with-vector-footer">
                <h2 class="text-no-wrap h4-md-sg mobile-14 text-color-white">cadastre-se na nossa</h2>
                <div class="d-inline-flex">
                  <div class="text-vetor footer"></div>
                  <h2 class="h4-md-sg mobile-14 text-color-white">newsletter</h2>
                </div>
              </div>
            </div>
            <div class="margin-top margin-small">
              <div class="cta26_form-block w-form">
                <div class="cta26_form">
                  {% form 'customer', class: 'signup-form-wrapper' %}
                    <input
                      id="email"
                      type="email"
                      name="contact[email]"
                      class="form_input-footer w-input"
                      value="{{ form.email }}"
                      aria-required="true"
                      autocorrect="off"
                      autocapitalize="off"
                      autocomplete="email"
                      {% if form.errors %}
                        autofocus
                        aria-invalid="true"
                        aria-describedby="Newsletter-error--{{ section.id }}"
                      {% elsif form.posted_successfully? %}
                        aria-describedby="Newsletter-success--{{ section.id }}"
                      {% endif %}
                      required
                    >
                    <button
                      type="submit"
                      class="btn-primary h6-sg right w-button"
                      name="commit"
                      id="Subscribe"
                      aria-label="{{ 'newsletter.button_label' | t }}"
                    >
                      Enviar
                    </button>

                    <div>
                      {%- if form.errors -%}
                        <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">
                          {%- render 'icon-error' -%}
                          {{- form.errors.translated_fields.email | capitalize }}
                          {{ form.errors.messages.email -}}
                        </small>
                      {%- endif -%}

                      {%- if form.posted_successfully? -%}
                        <h3
                          class="newsletter-form__message form__message no-margins text-color-white"
                          id="Newsletter-success--{{ section.id }}"
                          tabindex="-1"
                          autofocus
                        >
                          {% render 'icon-success' -%}
                          {{- 'newsletter.success' | t }}
                        </h3>
                      {%- endif -%}
                    </div>
                  {% endform %}
                  <div class="politica-newsletter text-align-left text-color-white opacity-70">
                    CLICANDO EM ENVIAR VOCÊ CONCORDA COM OS TERMOS E CONDIÇÕES da BOMA
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div
        id="w-node-_3c7ed6fa-2af1-b985-1b01-082a21afaab5-21afaaa5"
        class="w-layout-grid footer4_social-list div-block-4 small-hide"
      >
        <div class="d-flex flex-column social-wrap">
          <div class="d-flex align-items-center">
            <a
              href="https://www.instagram.com/weare_boma/"
              target="_blank"
              class="btn-footer is-link h5-sg text-color-white"
              >instagram</a
            >
          </div>

          <div class="d-flex align-items-center">
            <a
              href="https://www.youtube.com/@boma3263"
              target="_blank"
              class="btn-footer is-link h5-sg text-color-white"
              >youtube</a
            >
          </div>

          <div class="d-flex align-items-center">
            <a
              href="https://open.spotify.com/user/jpmhidxq4xu5d9uhf249wgku3?si=58ac76862e66495b"
              target="_blank"
              class="btn-footer is-link h5-sg text-color-white"
              >spotify</a
            >
          </div>
        </div>
      </div>
    </div>
    <div class="copyright_wrap d-flex">
      <div class="art-over-footer-wrap text-color-white">
        <span class="h5-sg">art over money</span>
        <span class="mobile-14 copyright opacity-70"
          >©2024 Boma all rights reserved . designed by
          <a href="https://toonbo.com.br" class="text-color-white toonbo">toonbo</a></span
        >
      </div>

      <div class="copyright_links">
        <a class="mobile-14 text-color-white opacity-md-70" href="/pages/politica-de-privacidade2"
          >Política de privacidade</a
        >
        <a class="mobile-14 text-color-white opacity-md-70" href="/pages/termos-de-servico">Termos de serviço</a>
        <a class="mobile-14 text-color-white opacity-md-70" href="/pages/politica-de-envios">Política de envio</a>
        <a class="mobile-14 text-color-white opacity-md-70" href="/pages/politica-de-trocas-e-devolucoes"
          >Política de troca e devolução</a
        >
      </div>
    </div>
  </footer>
</div>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto&display=swap" rel="stylesheet">

<!-- mouse circle -->
<div class="circle"></div>

<script
  defer
  src="https://code.jquery.com/jquery-3.7.1.min.js"
  integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
  crossorigin="anonymous"
></script>
<script defer src="https://cdnjs.cloudflare.com/ajax/libs/gsap/1.18.0/TweenMax.min.js"></script>

<script>
  window.addEventListener('DOMContentLoaded', function () {
    let $circle = $('.circle');

    function moveCircle(e) {
      TweenLite.to($circle, 0.3, {
        css: {
          left: e.pageX,
          top: e.pageY,
        },
      });
    }

    $(window).on('mousemove', moveCircle);
  });
</script>

<style>
  .circle {
    position: absolute;
    width: 14px;
    height: 14px;
    top: 50%;
    left: 50%;
    margin: -40px 0 0 -40px;
    background: var(--red, #fb0d1b);
    border-radius: 80%;
    backface-visibility: hidden;
    mix-blend-mode: hard-light;
    z-index: 99;
  }

  @media (max-width: 991px) {
    .circle {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.brand_information.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Image width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Image alignment on large screen",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.spacing"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.footer.settings.margin_top.label",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ]
}
{% endschema %}
