{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: calc({{ section.settings.padding_top }}px * 0.75);
    padding-bottom: calc({{ section.settings.padding_bottom }}px  * 0.75);
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<style>
  .heading-veritas-block {
    padding-inline: 24px;
    display: inline-block;
    position: relative;
  }

  .heading-veritas-block::after {
    z-index: -1;
    content: '';
    display: block;
    width: 100%;
    height: 58%;
    background-color: var(--yellow);
    position: absolute;
    inset: 0;
    margin: auto;
  }

  .heading-veritas-block.blue {
    background-color: var(--blue);
  }

  .ver-mais {
    align-items: center;
    padding-inline: 24px;
    line-height: 1;
    background-color: black;
    color: white;
    height: 30px;
  }
</style>

<div class="section-{{ section.id }}-padding">
  <div class="d-flex justify-content-between align-items-center">
    <div class="heading-veritas-block {% if section.settings.exibir_azul %}blue{% endif %}">
      <h2 class="h4-sg">{{ section.settings.heading }}</h2>
    </div>
    {% if section.settings.exibir and section.settings.link != blank %}
      <a class="d-flex ver-mais h4-sg text-hover-red" href="{{ section.settings.link }}">
        <span>+</span>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Heading Veritas",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Veritas"
    },
    {
      "type": "checkbox",
      "id": "exibir",
      "label": "Exibir +",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "exibir_azul",
      "label": "Section azul",
      "default": false
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link do ver +",
      "info": "É necessário escolher um link para que o link apareça."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 52
    }
  ],
  "presets": [
    {
      "name": "Heading Veritas"
    }
  ]
}
{% endschema %}
